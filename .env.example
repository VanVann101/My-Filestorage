# Статический ключ доступа сервисного аккаунта Yandex Cloud.
# Нужны права storage.uploader на бакет (или storage.editor).
YC_ACCESS_KEY_ID=
YC_SECRET_ACCESS_KEY=

# Имя бакета в Object Storage
YC_BUCKET=wedding-ivan-inna-2026

# Обычно менять не нужно
YC_REGION=ru-central1
YC_ENDPOINT=https://storage.yandexcloud.net

# Идентификатор события — становится префиксом ключей в бакете
EVENT_ID=wedding-2026
EVENT_TITLE=Свадьба Ивана и Инны

# Сколько дней живёт подпись. Дольше 7 дней ставить не стоит.
POLICY_DAYS=7

# Максимальный размер одного файла, МБ
MAX_FILE_MB=2048

# Ссылка, которую зашиваем в QR-код
PUBLIC_URL=https://vanvann101.github.io/My-Filestorage/
