# Статический ключ доступа сервисного аккаунта Yandex Cloud.
# Нужны права storage.uploader на бакет (или storage.editor).
YC_ACCESS_KEY_ID=
YC_SECRET_ACCESS_KEY=

# Имя бакета в Object Storage
YC_BUCKET=wedding-ivan-inna-2026

# Обычно менять не нужно
YC_REGION=ru-central1
YC_ENDPOINT=https://storage.yandexcloud.net

# Идентификатор события — становится префиксом ключей в бакете
EVENT_ID=wedding-2026
EVENT_TITLE=Свадьба Ивана и Инны

# Сколько дней живёт подпись POST-политики. Технического потолка нет —
# это просто дата в подписанном JSON. Берите с запасом до события: ежедневный
# крон в Actions продлевает её сам, но GitHub отключает schedule-крон, если
# в репозитории 60 дней нет активности, так что запас не помешает.
POLICY_DAYS=150

# Максимальный размер одного файла, МБ
MAX_FILE_MB=2048

# Ссылка, которую зашиваем в QR-код
PUBLIC_URL=https://vanvann101.github.io/My-Filestorage/

# Пароль входа на /admin.html (скрыть отдельных гостей из общей галереи).
# Это НЕ настоящая защита: пароль попадает как обычная строка в собранный
# JS и виден в исходниках страницы, а запись в бакет идёт через ту же
# открытую POST-политику, что и у гостей. Годится только как барьер от
# случайного захода на страницу, не от намеренного взлома.
VITE_ADMIN_PASSWORD=
